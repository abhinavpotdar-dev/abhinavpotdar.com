
{
  "name": "abhinavpotdar-com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "preview:web": "npm run preview --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "start:api": "npm run start --workspace=api",
    "build": "npm run build --workspace=web"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
